# Copy to .env.local (Vite only loads VITE_-prefixed vars into the client bundle).
# Anything here ships to the browser — never put a secret in this file.

# ─── Backend origin ─────────────────────────────────────────────────────────────
# Leave EMPTY for same-origin. In dev that's what you want: the Vite proxy
# forwards /api to http://localhost:5000 (see vite.config.js).
# Set it only when the API lives on a different origin, e.g.
#   VITE_BACKEND_URL=https://api.builderai.com
VITE_BACKEND_URL=

# ─── Google Maps Embed API ──────────────────────────────────────────────────────
# Optional. Powers the maps on the project-detail and profile pages. Without it
# those maps degrade to a "open in Google Maps" deep-link fallback.
# Get a key: Google Cloud Console > APIs & Services > enable "Maps Embed API".
# Restrict it by HTTP referrer — it is public in the bundle.
# (The landing-page map uses Leaflet/OpenStreetMap and needs no key.)
VITE_GOOGLE_MAPS_API_KEY=
