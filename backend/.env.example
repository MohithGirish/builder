# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Either set the discrete DB_* vars below, or set DATABASE_URL (a single
# postgres://user:pass@host:port/db string) which takes precedence over them.
# Managed hosts (RDS, Neon, Render) usually hand you DATABASE_URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=builder_ai_db
DB_USER=builder_admin
DB_PASSWORD=builder_secret_dev

# ─── Redis (cache) ──────────────────────────────────────────────────────────────
# Optional. If REDIS_HOST is unset the app falls back to an in-memory cache, so
# it boots fine without Redis. Under Docker Compose this is set to `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Only the ACCESS token is a JWT. Refresh tokens are opaque 64-byte random hex
# stored in the refresh_tokens table — they are not signed, so there is no
# refresh secret to configure.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
# Refresh-token lifetime, in seconds (604800 = 7 days).
JWT_REFRESH_EXPIRES_SECONDS=604800

# ─── Admin seeder credentials ───────────────────────────────────────────────────
# REQUIRED for seeding: `npm run db:seed` / `db:reset` throws (fails loudly) if
# either is unset, because without an admin /admin is unreachable and builder
# verifications cannot be approved. Never falls back to a hardcoded password.
# Generate a strong password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Security ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
# Number of reverse proxies in front of the app, for correct client IPs in
# rate limiting (Express `trust proxy`). Only read when NODE_ENV=production.
# 1 is right behind a single ALB / Nginx / Cloudflare hop. Defaults to 1.
TRUST_PROXY_HOPS=1

# NOTE: the backend test suite exceeds these limits (auth.test.js alone blows past
# AUTH_RATE_LIMIT_MAX=10). Run tests with the limits raised:
#   AUTH_RATE_LIMIT_MAX=1000 RATE_LIMIT_MAX_REQUESTS=1000 npm test

# ─── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────────
# Enable 2FA on Gmail, generate an App Password at Google Account > Security.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_16_char_app_password
FRONTEND_URL=http://localhost:3000

# ─── WhatsApp Business Cloud API ────────────────────────────────────────────────
# Obtain these from the Meta for Developers dashboard (WhatsApp > API Setup).
# Leave blank in development — messages are logged to console instead of being sent.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=quote_confirmation
# Country code prepended to national-only numbers (digits, no +). Default 91 (India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Claude API key for AI onboarding chat (optional — without it onboarding falls back to the scripted flow)
ANTHROPIC_API_KEY=

# ─── AI Matchmaking microservice ────────────────────────────────────────────────
# Unused: the backend has no call site for the Python AI service yet, and the
# service is not deployed. When it is wired in, this is the shared secret sent as
# the X-Internal-Api-Key header and it must match that service's INTERNAL_API_KEY.
AI_SERVICE_API_KEY=
