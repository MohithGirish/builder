# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=builder_ai_db
DB_USER=builder_admin
DB_PASSWORD=builder_secret_dev

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_SECONDS=604800

# ─── Admin seeder credentials ───────────────────────────────────────────────────
# REQUIRED for seeding: `npm run db:seed` / `db:reset` throws (fails loudly) if
# either is unset, because without an admin /admin is unreachable and builder
# verifications cannot be approved. Never falls back to a hardcoded password.
# Generate a strong password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Security ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────────
# Enable 2FA on Gmail, generate an App Password at Google Account > Security.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_16_char_app_password
FRONTEND_URL=http://localhost:3000

# ─── WhatsApp Business Cloud API ────────────────────────────────────────────────
# Obtain these from the Meta for Developers dashboard (WhatsApp > API Setup).
# Leave blank in development — messages are logged to console instead of being sent.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=quote_confirmation
# Country code prepended to national-only numbers (digits, no +). Default 91 (India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Claude API key for AI onboarding chat (optional — without it onboarding falls back to the scripted flow)
ANTHROPIC_API_KEY=

# ─── AI Matchmaking microservice ────────────────────────────────────────────────
# Unused: the backend has no call site for the Python AI service yet, and the
# service is not deployed. When it is wired in, this is the shared secret sent as
# the X-Internal-Api-Key header and it must match that service's INTERNAL_API_KEY.
AI_SERVICE_API_KEY=
