# ─── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ─── Internal auth (shared secret with Node backend) ───────────────────────────
# Optional. If set (non-empty), every /api/v1/match/* request must send a matching
# X-Internal-Api-Key header or it is rejected with 401. Leave empty to disable
# enforcement (dev mode). Must match the backend's AI_SERVICE_API_KEY.
INTERNAL_API_KEY=replace_with_strong_shared_secret
